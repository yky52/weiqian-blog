---
import type { CollectionEntry } from 'astro:content';
import { ts, type Lang } from '../i18n/ui';
import { formatDate } from '../utils/format';
import { postUrl } from '../utils/posts';
import { readingTime } from '../utils/reading';

interface Props {
	post: CollectionEntry<'blog'>;
	lang?: Lang;
}

const { post, lang = 'zh' } = Astro.props;
const { title, description, pubDate, category, tags, sticky } = post.data;
---

<a class="post-card" href={postUrl(post)}>
	<div class="post-meta">
		{sticky && <span class="sticky-badge">{ts(lang, 'sticky')}</span>}
		<time>{formatDate(pubDate)}</time>
		<span>{category}</span>
		<span>{readingTime(post.body)} {ts(lang, 'min_read')}</span>
	</div>
	<h2>{title}</h2>
	<p>{description}</p>
	{
		tags.length > 0 && (
			<div class="post-meta" style="margin-top:0.6rem">
				{tags.map((t) => (
					<span class="tag">#{t}</span>
				))}
			</div>
		)
	}
</a>
