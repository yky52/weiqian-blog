---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { htmlLang, ts, type Lang } from '../i18n/ui';

interface Props {
	lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
---

<html lang={htmlLang(lang)}>
	<head>
		<BaseHead title={ts(lang, 'search_title')} lang={lang} />
		<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
	</head>
	<body>
		<Header lang={lang} />
		<main data-pagefind-body>
			<h1 style="margin-top:0">{ts(lang, 'search_title')}</h1>
			<div id="search"></div>
		</main>
		<Footer lang={lang} />
		<script src="/pagefind/pagefind-ui.js" is:inline></script>
		<script is:inline define:vars={{ placeholder: ts(lang, 'search_placeholder') }}>
			window.addEventListener('DOMContentLoaded', function () {
				new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
				var input = document.querySelector('.pagefind-ui__search-input');
				if (input) input.setAttribute('placeholder', placeholder);
			});
		</script>
		<style>
			#search {
				--pagefind-ui-scale: 1;
				--pagefind-ui-primary: var(--text);
				--pagefind-ui-text: var(--text);
				--pagefind-ui-background: var(--bg-card);
				--pagefind-ui-border: var(--border);
				--pagefind-ui-tag: var(--bg-soft);
				--pagefind-ui-border-width: 1px;
				--pagefind-ui-border-radius: 18px;
				--pagefind-ui-font: var(--font-sans);
			}
			#search .pagefind-ui__search-input {
				color: var(--text);
			}
			#search .pagefind-ui__result-title a {
				color: var(--accent);
			}
			#search mark {
				background: var(--accent-soft);
				color: var(--accent);
			}
		</style>
	</body>
</html>
