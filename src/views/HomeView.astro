---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE } from '../consts';
import { htmlLang, ts, type Lang } from '../i18n/ui';

interface Props {
	lang?: Lang;
	page: Page<CollectionEntry<'blog'>>;
}

const { lang = 'zh', page } = Astro.props;
const homePath = lang === 'en' ? '/en/' : '/';
---

<html lang={htmlLang(lang)}>
	<head>
		<BaseHead
			title={page.currentPage === 1 ? undefined : `Page ${page.currentPage}`}
			lang={lang}
		/>
	</head>
	<body>
		<Header lang={lang} />
		<main data-pagefind-body>
			{
				page.currentPage === 1 && (
					<section class="hero">
						<h1>{ts(lang, 'hero_title')}</h1>
						<p>{ts(lang, 'hero_desc')}</p>
					</section>
				)
			}

			{page.data.map((post) => <PostCard post={post} lang={lang} />)}

			{
				page.lastPage > 1 && (
					<nav class="pagination" aria-label="pagination">
						{page.url.prev ? (
							<a href={page.url.prev}>←</a>
						) : (
							<span style="opacity:0.4">←</span>
						)}
						{Array.from({ length: page.lastPage }, (_, i) => {
							const n = i + 1;
							const href = n === 1 ? homePath : `${homePath}${n}/`;
							return n === page.currentPage ? (
								<span class="current">{n}</span>
							) : (
								<a href={href}>{n}</a>
							);
						})}
						{page.url.next ? (
							<a href={page.url.next}>→</a>
						) : (
							<span style="opacity:0.4">→</span>
						)}
					</nav>
				)
			}
		</main>
		<Footer lang={lang} />
		<style>
			.hero {
				margin-bottom: 3rem;
			}
			.hero h1 {
				font-size: 2.6rem;
				margin: 0 0 0.5rem;
				letter-spacing: -0.03em;
			}
			.hero p {
				margin: 0;
				color: var(--text-soft);
				font-size: 1.15rem;
			}
			@media (max-width: 640px) {
				.hero h1 {
					font-size: 2rem;
				}
			}
		</style>
	</body>
</html>
